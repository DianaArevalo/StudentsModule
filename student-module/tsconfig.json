{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",

    "outDir": "./dist",
    "sourceMap": true,
    "incremental": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "types": ["node", "jest"]
  }
}
